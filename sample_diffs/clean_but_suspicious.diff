 import hashlib
 import secrets

 from .db import get_conn

 ALLOWED_REDIRECTS = {"/home", "/dashboard", "/settings"}

+USER_LOOKUP_SQL = "SELECT id, email FROM users WHERE id = %s"
+
+
+def find_user(uid):
+    cur = get_conn().cursor()
+    cur.execute(USER_LOOKUP_SQL, (uid,))
+    return cur.fetchone()
+
+
 def new_csrf_token():
     return secrets.token_hex(32)


